# Copia este archivo a .env y completa los valores reales.
# Ninguna de estas variables tiene un valor por defecto funcional en producción.

# ── Base de datos (Postgres / Supabase) ──────────────────────────
DATABASE_URL=

# ── OpenAI (Sara, Isabella, Valeria, Camilo, chatbot, WhatsApp) ──
OPENAI_API_KEY=

# ── Correo saliente (SMTP) + poller IMAP de correo entrante ──────
SMTP_USER=
SMTP_PASS=
# Etiqueta/carpeta de Gmail a monitorear (por defecto: GLP-Leads)
IMAP_MAILBOX=GLP-Leads
# Palabras clave para filtrar asunto SOLO si IMAP_MAILBOX=INBOX (coma-separadas)
IMAP_SUBJECT_KEYWORDS=glp,inversión,inversion,proyecto,panama,panamá,inmueble,apartamento,propiedad
# Correo que recibe notificación cuando Sara genera un borrador nuevo
ADMIN_EMAIL=

# ── WhatsApp Business (Meta Cloud API) ───────────────────────────
# Se obtienen desde el Meta Business App (developers.facebook.com):
# 1. Crea una app tipo "Business" y agrega el producto "WhatsApp".
# 2. WHATSAPP_PHONE_NUMBER_ID: en WhatsApp > Configuración de la API, el número de prueba
#    o el número verificado de producción.
# 3. WHATSAPP_ACCESS_TOKEN: token temporal (24h) para pruebas, o token permanente de un
#    System User para producción.
# 4. WHATSAPP_VERIFY_TOKEN: lo defines tú mismo (cualquier string) — Meta te lo pide de
#    vuelta al configurar el webhook, para confirmar que el endpoint es tuyo.
# 5. El webhook (GET/POST /webhook/whatsapp) necesita ser accesible por HTTPS público
#    (localhost no sirve) — usa ngrok para pruebas o la URL real una vez desplegado.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# ── DocuSign (firma digital de documentos legales) ───────────────
# Se obtienen desde el DocuSign Admin (admin.docusign.com) > Apps and Keys:
# 1. Crea una app, genera un par de llaves RSA (DocuSign te da la pública/privada).
# 2. DOCUSIGN_INTEGRATION_KEY: el Client ID / Integration Key de la app.
# 3. DOCUSIGN_USER_ID: el User ID (GUID) del usuario que firma en nombre de GLP —
#    debes dar consentimiento una vez visitando la URL de "JWT consent" de DocuSign.
# 4. DOCUSIGN_ACCOUNT_ID: el Account ID visible en la misma pantalla de Apps and Keys.
# 5. DOCUSIGN_PRIVATE_KEY: la llave privada RSA completa (formato PEM), con saltos de
#    línea escritos como \n si se pega en una sola línea.
# 6. DOCUSIGN_BASE_PATH: https://account-d.docusign.com para pruebas (sandbox/demo),
#    https://account.docusign.com para producción.
# 7. El webhook (POST /webhook/docusign) necesita ser accesible por HTTPS público para
#    que DocuSign Connect pueda notificar cambios de estado (mismo requisito que WhatsApp).
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_PRIVATE_KEY=
DOCUSIGN_BASE_PATH=https://account-d.docusign.com

PORT=3001
